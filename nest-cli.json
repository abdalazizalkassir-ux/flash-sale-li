{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/flash-sale/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/flash-sale/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/flash-sale",
  "projects": {
    "flash-sale": {
      "type": "application",
      "root": "apps/flash-sale",
      "entryFile": "main",
      "sourceRoot": "apps/flash-sale/src",
      "compilerOptions": {
        "tsConfigPath": "apps/flash-sale/tsconfig.app.json"
      }
    },
    "fulfillment-service": {
      "type": "application",
      "root": "apps/fulfillment-service",
      "entryFile": "main",
      "sourceRoot": "apps/fulfillment-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/fulfillment-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    }
  }
}
